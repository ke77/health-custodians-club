# HCC website environment variables
# copy to .env.local and fill in. never commit .env.local.
# EMAIL_FROM stays blank until the domain is verified in Resend, then set it to: Health Custodians Club <info@healthcustodiansclub.com>

# public site url: the live domain. also used for links inside emails.

NEXT_PUBLIC_SITE_URL=https://healthcustodiansclub.com

# supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only. never prefix with NEXT_PUBLIC. never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# cloudflare turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# resend (email). EMAIL_FROM needs a verified domain, so it stays blank until the domain is set up.
RESEND_API_KEY=
EMAIL_FROM=

# cron (keep-alive). set the same value in vercel project env.
CRON_SECRET=

# salt for hashing ip addresses before rate limiting
RATE_LIMIT_SALT=
