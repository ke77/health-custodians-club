# HCC website environment variables
# copy to .env.local and fill in. never commit .env.local.
# values left blank are added when the club's accounts and domain exist (see docs/05-data-model.md).

# public site url. final domain healthcustodiansclub.com (placeholder, not bought yet).
# until it is bought and verified, the site runs on the vercel subdomain below.
NEXT_PUBLIC_SITE_URL=https://healthcustodiansclub.vercel.app

# supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only. never prefix with NEXT_PUBLIC. never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# cloudflare turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# resend (email). EMAIL_FROM needs a verified domain, so it stays blank until the domain is set up.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=

# cron (keep-alive). set the same value in vercel project env.
CRON_SECRET=

# salt for hashing ip addresses before rate limiting
RATE_LIMIT_SALT=
